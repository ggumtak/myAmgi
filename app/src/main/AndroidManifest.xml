<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <permission
        android:name="${applicationId}.permission.READ_WRITE_DATABASE"
        android:label="myAmgi 데이터베이스 접근"
        android:protectionLevel="normal" />

    <queries>
        <package android:name="com.ggumtak.hanja" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="hanja" />
        </intent>
        <!-- platform.tts: bind to the installed text-to-speech engine -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MyAmgiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAmgi"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            The whole UI: a WebView on the local host server. Rotation, size, keyboard and density changes are
            handled in place so the page survives them; a dark-mode switch (uiMode) recreates the activity so
            the WebView's prefers-color-scheme follows the system.
        -->
        <activity
            android:name=".shell.HostActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|fontScale">
            <!-- Open with: Anki packages and text/CSV files from a file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.apkg" />
                <data android:pathPattern=".*\\.colpkg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/vnd.anki" />
                <data android:mimeType="application/x-colpkg" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
            <!-- Share target -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/vnd.anki" />
                <data android:mimeType="application/x-colpkg" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>
        </activity>

        <!--
            Launcher entry. Keeps the component name of the native UI's launcher activity (builds <= 11) so home
            screen shortcuts made before the upgrade keep working; it opens HostActivity.
        -->
        <activity-alias
            android:name=".ui.MainActivity"
            android:exported="true"
            android:targetActivity=".shell.HostActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".provider.MyAmgiProvider"
            android:authorities="${providerAuthority}"
            android:exported="true"
            android:readPermission="${applicationId}.permission.READ_WRITE_DATABASE"
            android:writePermission="${applicationId}.permission.READ_WRITE_DATABASE" />

        <!-- platform.share: host exports, under their display names -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${fileProviderAuthority}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
