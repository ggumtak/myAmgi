<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <permission
        android:name="${applicationId}.permission.READ_WRITE_DATABASE"
        android:label="myAmgi 데이터베이스 접근"
        android:protectionLevel="normal" />

    <queries>
        <package android:name="com.ggumtak.hanja" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="hanja" />
        </intent>
    </queries>

    <application
        android:name=".MyAmgiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAmgi"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.apkg" />
                <data android:pathPattern=".*\\.colpkg" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.StudyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation" />

        <activity
            android:name=".ui.NoteEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.TemplateEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.DeckOptionsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AnkiPageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CardBrowserActivity"
            android:exported="false" />

        <provider
            android:name=".provider.MyAmgiProvider"
            android:authorities="${providerAuthority}"
            android:exported="true"
            android:readPermission="${applicationId}.permission.READ_WRITE_DATABASE"
            android:writePermission="${applicationId}.permission.READ_WRITE_DATABASE" />

        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
