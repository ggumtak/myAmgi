<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred by Android (API 31+; android:allowBackup="false" covers older
  releases). Auto Backup would copy the live SQLite collection, the saved AnkiWeb key, the OTA UI and
  temp files, and a restore could bring back a stale, inconsistent collection. myAmgi has its own
  backups (backup.create / .colpkg export) and AnkiWeb sync instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
