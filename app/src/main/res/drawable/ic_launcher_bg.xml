<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Midnight to Royal Cobalt diagonal gradient -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="6"
                android:endX="102"
                android:endY="102">
                <item android:offset="0.0" android:color="#FF081024" />
                <item android:offset="0.52" android:color="#FF132968" />
                <item android:offset="1.0" android:color="#FF1D4ED8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle soft radial cobalt glow near bottom-right (82, 86) for depth -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="82"
                android:centerY="86"
                android:gradientRadius="68">
                <item android:offset="0.0" android:color="#4D3B82F6" />
                <item android:offset="0.55" android:color="#1A2563EB" />
                <item android:offset="1.0" android:color="#001D4ED8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
